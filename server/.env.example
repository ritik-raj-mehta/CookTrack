PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/CookTrack?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_key_here
JWT_REFRESH_SECRET=your_super_refresh_secret_key_here
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
JWT_EXPIRES_MINUTES=1440
CLIENT_URL=https://cook-track-six.vercel.app,http://localhost:5173

# Cloud HTTP Email API (Recommended for Render Free Tier - Port 443)
RESEND_API_KEY=
RESEND_FROM=CookTrack <onboarding@resend.dev>

# Direct SMTP
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
